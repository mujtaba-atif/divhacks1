# All credentials stay server-side. Default configuration runs without keys.
RENTESCROW_STORAGE=local
# MONGODB_URI=
MONGODB_DATABASE=rentescrow

# Enable real analysis of tenant uploads. Sample evidence stays a demo fixture.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public NYC lookup works without a token; a token may increase request limits.
# NYC_OPEN_DATA_APP_TOKEN=

# Nessie is mock banking. Set both credentials and opt in to load its data.
NESSIE_ENABLED=false
# NESSIE_API_KEY=
# NESSIE_ACCOUNT_ID=
# NESSIE_RENT_PAYEE=

# Real iMessage delivery requires this opt-in and a fixed approved recipient.
PHOTON_LIVE_SEND=false
# PHOTON_PROXY_TOKEN=
# PHOTON_ALLOWED_RECIPIENT=

# Optional real Testnet Payment settlement. USD escrow remains simulated.
# Run pnpm xrpl:setup-testnet once to create/fund dedicated wallets in .env.local.
XRPL_SETTLEMENT_ENABLED=false
XRPL_NETWORK=testnet
XRPL_RPC_URL=wss://s.altnet.rippletest.net:51233
# XRPL_TENANT_ADDRESS=
# XRPL_TENANT_SEED=
# XRPL_LANDLORD_ADDRESS=
XRPL_SETTLEMENT_AMOUNT_XRP=10

# Independent native escrow operator tooling (not the app's Payment flow).
XRPL_TESTNET_ENABLED=false
# XRPL_TESTNET_SEED=
# XRPL_TESTNET_PREIMAGE_HEX=
# XRPL_TESTNET_APPROVAL_JSON=
