{
  "name": "rentescrow-nyc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:check": "node --conditions=react-server --import tsx scripts/check-mongodb.ts",
