{
  "name": "rentescrow-nyc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:check": "node --conditions=react-server --import tsx scripts/check-mongodb.ts",
    "seed:users": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed-users.ts",
    "nessie:check": "node --conditions=react-server --import tsx scripts/check-nessie.ts",
    "nessie:seed": "node --import tsx scripts/seed-nessie-demo.ts",
    "agent": "node --conditions=react-server --import tsx scripts/spectrum-replies.ts",
    "photon:check": "node --conditions=react-server --import tsx scripts/check-photon.ts",
    "photon:bind": "node --conditions=react-server --import tsx scripts/bind-photon-case.ts",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "xrpl:setup-testnet": "node --conditions=react-server --import tsx scripts/xrpl-setup-testnet.ts",
    "xrpl:prepare-demo": "node --env-file=.env.local --conditions=react-server --import tsx scripts/xrpl-prepare-demo.ts",
    "xrpl:setup-rlusd": "node --env-file=.env.local --conditions=react-server --import tsx scripts/xrpl-setup-rlusd.ts",
    "contracts:evaluate": "node --env-file=.env.local --conditions=react-server --import tsx scripts/contracts-evaluate.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.15.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "spectrum-ts": "12.10.1",
    "xrpl": "^4.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
